{
  "name": "lightbot",
  "version": "1.1.0",
  "description": "Lightbot is an educational game about programming designed for introductory courses to logical thinking.",
  "main": "index.js",
  "scripts": {
    "clean": "rimraf deploy && shx mkdir -p deploy/js deploy/css",
    "build:js": "google-closure-compiler --flagfile gcc-flags.txt",
    "build:css": "cleancss src/develop/css/smoothness/jquery-ui-1.8.16.custom.css src/develop/css/jplayer.css src/develop/css/lightbot.css -o deploy/css/lightbot.min.css",
    "copy:base": "copyfiles -u 2 src/deploy/index.html src/develop/img/** src/develop/media/** src/develop/js/jquery*.js deploy",
    "copy:css-img": "copyfiles -u 4 src/develop/css/smoothness/images/** deploy/css",
    "build": "npm-run-all clean --parallel build:* copy:*"
  },
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "copyfiles": "^2.4.1",
    "google-closure-compiler": "^20251111.0.0",
    "rimraf": "^6.1.2",
    "shx": "^0.4.0",
    "npm-run-all": "^4.1.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haan/Lightbot.git"
  },
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/haan/Lightbot/issues"
  },
  "homepage": "https://github.com/haan/Lightbot#readme"
}